{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kinno.dev/schemas/sejong/repo-index.schema.json",
  "title": "King Sejong Reconstructable Repository Index",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {"const": "king-sejong.repo-index/v0.1"},
    "repo_identity": {"type": "string", "minLength": 1},
    "contexts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "active_context_id": {"type": "string", "minLength": 1},
          "context_ref": {"type": "string", "minLength": 1},
          "context_status": {"enum": ["active", "paused", "completed", "closed"]},
          "last_updated_at": {"type": "string", "format": "date-time"}
        },
        "required": ["active_context_id", "context_ref", "context_status", "last_updated_at"]
      }
    },
    "rebuilt_at": {"type": "string", "format": "date-time"}
  },
  "required": ["format", "repo_identity", "contexts", "rebuilt_at"]
}
